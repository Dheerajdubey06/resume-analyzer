# ==========================================
# ResumeAI — Environment Configuration
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend & Backend URLs
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/resumeai?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/resumeai

# JWT Secret & Expiration
JWT_SECRET=super_secret_jwt_key_resume_ai_2026_change_in_production
JWT_EXPIRES_IN=7d

# Cloudinary Configuration (For PDF/DOCX resume file & profile photo storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI Provider Configuration (OpenAI API)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Max Upload File Size in Bytes (default 10MB)
MAX_FILE_SIZE=10485760

# Demo / Fallback Mode (If true or if credentials pending, enables realistic intelligent fallback responses)
DEMO_MODE=false
